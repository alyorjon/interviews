# Telegram bot token from @BotFather. Empty disables the bot and signed progress sync.
BOT_TOKEN=
# polling: one replica only (Telegram allows a single getUpdates consumer).
# webhook: any number of replicas; requires TELEGRAM_WEBHOOK_SECRET (16+ chars of A-Z a-z 0-9 _ -).
BOT_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
# "*" or empty = every signed Telegram user may sync progress; or a comma-separated allowlist.
ALLOWED_TELEGRAM_USER_IDS=
# Receives the startup message (polling mode). Legacy ALLOWED_TELEGRAM_USER_ID (one ID or a comma-separated
# list) is the fallback allowlist, and its first ID the fallback admin, when the two settings above are empty.
ADMIN_TELEGRAM_USER_ID=
ALLOWED_TELEGRAM_USER_ID=
PUBLIC_URL=
PUBLIC_HOSTNAME=
# Shared progress store. Without it progress lives in one process's memory.
REDIS_URL=
# Development only; refused when NODE_ENV=production.
AUTH_BYPASS=false
